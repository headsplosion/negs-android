{
 "prep": [
  {
   "title": "RAW White Balance",
   "tab": "Prep",
   "raw": true,
   "controls": [
    {
     "kind": "choice",
     "label": "White balance",
     "path": "io.raw_white_balance.mode",
     "options": [
      "as_shot",
      "daylight",
      "tungsten",
      "custom"
     ]
    },
    {
     "kind": "slider",
     "label": "Temperature (K)",
     "path": "io.raw_white_balance.temperature",
     "min": 1667,
     "max": 25000,
     "step": 1,
     "when": [
      "io.raw_white_balance.mode",
      "custom"
     ]
    },
    {
     "kind": "slider",
     "label": "Tint",
     "path": "io.raw_white_balance.tint",
     "min": 0.01,
     "max": 4,
     "step": 0.01,
     "when": [
      "io.raw_white_balance.mode",
      "custom"
     ]
    }
   ]
  },
  {
   "title": "Brightness",
   "tab": "Prep",
   "controls": [
    {
     "kind": "match",
     "label": "Match camera brightness",
     "tutorial": "match",
     "help": "Develops the RAW about as bright as the camera’s own preview, and keeps it there when you change film, paper or a preset. Exposure adds to it."
    },
    {
     "kind": "offset",
     "label": "Exposure (EV)",
     "path": "prep.exposure_ev",
     "min": -3,
     "max": 3,
     "step": 0.05
    },
    {
     "kind": "note",
     "label": "Camera brightness"
    },
    {
     "kind": "toggle",
     "label": "Auto exposure",
     "path": "camera.auto_exposure",
     "metering": true,
     "help": "Meters the photograph and exposes the film so the metered area lands on mid-grey, as a camera's meter does. Exposure adds to it."
    },
    {
     "kind": "choice",
     "label": "Metering",
     "path": "camera.auto_exposure_method",
     "options": [
      "average",
      "median",
      "center_weighted",
      "partial",
      "matrix",
      "multi_zone",
      "highlight_weighted"
     ],
     "when": "camera.auto_exposure",
     "metering": true
    }
   ]
  },
  {
   "title": "Tone",
   "tab": "Prep",
   "controls": [
    {
     "kind": "slider",
     "label": "Highlights",
     "path": "prep.highlights",
     "min": -180,
     "max": 100,
     "step": 1
    },
    {
     "kind": "slider",
     "label": "Shadows",
     "path": "prep.shadows",
     "min": -100,
     "max": 100,
     "step": 1
    },
    {
     "kind": "slider",
     "label": "Contrast",
     "path": "prep.contrast",
     "min": -100,
     "max": 100,
     "step": 1
    },
    {
     "kind": "slider",
     "label": "Lift",
     "path": "prep.lift",
     "min": -100,
     "max": 100,
     "step": 1
    },
    {
     "kind": "slider",
     "label": "Gain",
     "path": "prep.gain",
     "min": -100,
     "max": 100,
     "step": 1
    }
   ]
  },
  {
   "title": "Color",
   "tab": "Prep",
   "controls": [
    {
     "kind": "slider",
     "label": "Color Boost",
     "path": "prep.color_boost",
     "min": -100,
     "max": 100,
